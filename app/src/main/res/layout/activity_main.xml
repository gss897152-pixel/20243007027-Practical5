<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/main_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/color_header_background"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/main_title"
        android:textColor="@color/color_text_light"
        android:textSize="24sp" />

    <ImageView
        android:id="@+id/municipalities_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_weight="1"
        android:contentDescription="@string/map_description"
        android:scaleType="fitCenter"
        android:src="@drawable/chinese_municipalities" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:labelFor="@id/municipality_input"
        android:text="@string/input_label"
        android:textColor="@color/color_text_dark"
        android:textSize="22sp" />

    <EditText
        android:id="@+id/municipality_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"
        android:hint="@string/input_hint"
        android:imeOptions="actionGo"
        android:importantForAutofill="no"
        android:inputType="textCapWords|textNoSuggestions"
        android:singleLine="true"
        android:textColor="@color/color_text_dark"
        android:textColorHint="@color/color_header_background"
        android:textSize="18sp" />

</LinearLayout>
