<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    android:orientation="vertical"
    tools:context=".Municipality">

    <TextView
        android:id="@+id/municipality_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/color_header_background"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/color_text_light"
        android:textSize="26sp"
        tools:text="Beijing" />

    <ImageView
        android:id="@+id/municipality_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        tools:src="@drawable/beijing" />

    <ScrollView
        android:id="@+id/information_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/municipality_information"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:textColor="@color/color_text_dark"
            android:textSize="18sp" />
    </ScrollView>

    <Button
        android:id="@+id/visit_site"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:enabled="false"
        android:minHeight="48dp"
        android:text="@string/visit_site"
        android:textAllCaps="false" />

</LinearLayout>
